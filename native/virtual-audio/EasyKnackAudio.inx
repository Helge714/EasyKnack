[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=09/16/2026,0.1.0.0
CatalogFile=EasyKnackAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=EasyKnack,NT$ARCH$.10.0...22621
[EasyKnack.NT$ARCH$.10.0...22621]
%Device%=Audio,Root\EasyKnackAudio

[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
EasyKnackAudio.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
EasyKnackAudio.sys

[Audio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=Audio.AddReg
[Audio.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,EasyKnackAudio.sys
HKR,Drivers,SubClasses,,"wave"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%

[Audio.NT.Services]
AddService=EasyKnackAudio,0x00000002,Audio.Service
[Audio.Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\EasyKnackAudio.sys
[Audio.NT.Wdf]
KmdfService=EasyKnackAudio,Audio.Wdf
[Audio.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Audio.NT.Interfaces]
AddInterface=%AudioCategory%,"WaveSpeaker",Render.Interface
AddInterface=%RenderCategory%,"WaveSpeaker",Render.Interface
AddInterface=%RealtimeCategory%,"WaveSpeaker",Render.Interface
AddInterface=%AudioCategory%,"TopologySpeaker",Render.Interface
AddInterface=%TopologyCategory%,"TopologySpeaker",Render.Interface
AddInterface=%AudioCategory%,"WaveMicIn",Capture.Interface
AddInterface=%CaptureCategory%,"WaveMicIn",Capture.Interface
AddInterface=%RealtimeCategory%,"WaveMicIn",Capture.Interface
AddInterface=%AudioCategory%,"TopologyMicIn",Capture.Interface
AddInterface=%TopologyCategory%,"TopologyMicIn",Capture.Interface
[Render.Interface]
AddReg=Render.Properties
[Render.Properties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%RenderName%
[Capture.Interface]
AddReg=Capture.Properties
[Capture.Properties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%CaptureName%

[Strings]
Provider="EasyKnack"
Device="EasyKnack Virtual Audio"
Disk="EasyKnack Audio Driver"
RenderName="EasyKnack Input"
CaptureName="EasyKnack Output"
