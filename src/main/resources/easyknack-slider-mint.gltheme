# Optional coordinated accent theme; neutral workspace and original control geometry.
theme.type=bundle
theme.name=EasyKnack Mint
theme.extends=/easyknack.gltheme
theme.colors=/easyknack/themes/pastel.gltheme
theme.metrics=/easyknack/themes/borderless.gltheme

