# Shared moderately saturated type palette and accent routing for Mint and Amber.
theme.type=colors

button.pressedLight=${palette.accent}
button.pressedDark=${palette.accent}
button.hover=${palette.accent}
button.focus=${easyknack.accent.focus}
checkBox.focus=${easyknack.accent.focus}
checkBox.check=${easyknack.accent.focus}
textEditor.focus=${easyknack.accent.focus}
menu.hover=${palette.accent}
menuBar.hover=${palette.accent}
node.selectedBorder=${palette.accent}
node.activeSelectedBorder=${easyknack.accent.focus}
@COLOR easyknack.midi.keyboard.focus=${easyknack.accent.focus}
@COLOR curve.line=${easyknack.accent.focus}

@COLOR easyknack.signal.AUDIO=#B68ADB
@COLOR easyknack.signal.VALUE=#B4B4B4
@COLOR easyknack.signal.MIDI=#79C79F
@COLOR easyknack.signal.WAVETABLE=#83A7E2
@COLOR easyknack.signal.ANALYSIS=#D5BE6E
@COLOR easyknack.signal.SPECTRUM=${easyknack.signal.ANALYSIS}
@COLOR easyknack.signal.VECTOR=#71BDCF
@COLOR easyknack.signal.TRIGGER=#DBA16B
@COLOR easyknack.signal.HISTORY=#CF8DBD
@COLOR easyknack.signal.PARTIALS=#DF8B91

# Separate type hues with restrained brightness preserve white title text contrast.
@COLOR easyknack.node.AUDIO.title.light=#79529A
@COLOR easyknack.node.AUDIO.title.dark=${easyknack.node.AUDIO.title.light}
@COLOR easyknack.node.VALUE.title.light=#606060
@COLOR easyknack.node.VALUE.title.dark=${easyknack.node.VALUE.title.light}
@COLOR easyknack.node.MIDI.title.light=#3C7961
@COLOR easyknack.node.MIDI.title.dark=${easyknack.node.MIDI.title.light}
@COLOR easyknack.node.WAVETABLE.title.light=#4C68A0
@COLOR easyknack.node.WAVETABLE.title.dark=${easyknack.node.WAVETABLE.title.light}
@COLOR easyknack.node.ANALYSIS.title.light=#806B30
@COLOR easyknack.node.ANALYSIS.title.dark=${easyknack.node.ANALYSIS.title.light}
@COLOR easyknack.node.SPECTRUM.title.light=${easyknack.node.ANALYSIS.title.light}
@COLOR easyknack.node.SPECTRUM.title.dark=${easyknack.node.SPECTRUM.title.light}
@COLOR easyknack.node.VECTOR.title.light=#347888
@COLOR easyknack.node.VECTOR.title.dark=${easyknack.node.VECTOR.title.light}
@COLOR easyknack.node.TRIGGER.title.light=#946039
@COLOR easyknack.node.TRIGGER.title.dark=${easyknack.node.TRIGGER.title.light}
@COLOR easyknack.node.HISTORY.title.light=#915784
@COLOR easyknack.node.HISTORY.title.dark=${easyknack.node.HISTORY.title.light}
@COLOR easyknack.node.PARTIALS.title.light=#995259
@COLOR easyknack.node.PARTIALS.title.dark=${easyknack.node.PARTIALS.title.light}


# Borderless socket outlines; retain type-colored socket fills.
node.portBorder=#00000000

# Tooltips reuse menu styling and enforce a minimum stroke width in Core.
menu.border=#00000000
layoutGroup.border=#00000000
layoutGroup.focusBorder=#00000000
