# EasyKnack theme; loaded by the GLSwing theme loader.
theme.name=EasyKnack

@COLOR easyknack.node.title.text=#FFFFFF
@COLOR easyknack.node.GENERATOR.title.light=#796298
@COLOR easyknack.node.GENERATOR.title.dark=#51416A
@COLOR easyknack.node.EFFECT.title.light=#796298
@COLOR easyknack.node.EFFECT.title.dark=#51416A
@COLOR easyknack.node.MATH.title.light=${node.titleGradientLight}
@COLOR easyknack.node.MATH.title.dark=${node.titleGradientDark}
@COLOR easyknack.node.IO.title.light=#796298
@COLOR easyknack.node.IO.title.dark=#51416A
@COLOR easyknack.signal.AUDIO=#796298
@COLOR easyknack.signal.VALUE=#838383
@COLOR easyknack.signal.WAVETABLE=#E5AF55

slider.preferredWidth=120

node.cornerRadius=6
node.rowGap=6
node.minimumWidth=140
nodeEditor.horizontalNodeSpacing=60
nodeEditor.verticalNodeSpacing=40
node.contentPadding=12

# Shared GLSwing curve editor metrics, including the compact Hide preview.
curve.height=110
curve.previewHeight=32
curve.inspectorHeight=200
curve.padding=9
curve.pointRadius=3
curve.hitRadius=7
@COLOR curve.line=#DBBDFF
@COLOR curve.handle=#F4EFFF
@COLOR curve.marker=#E5AF55

@COLOR easyknack.node.MIDI.title.light=#57857E
@COLOR easyknack.node.MIDI.title.dark=#35564F
@COLOR easyknack.signal.MIDI=#57D9BA

@COLOR easyknack.midi.keyboard.focus=#4696FF

# Semantic node title palettes (independent of catalog folders).
@COLOR easyknack.node.AUDIO.title.light=${easyknack.node.GENERATOR.title.light}
@COLOR easyknack.node.AUDIO.title.dark=${easyknack.node.GENERATOR.title.dark}
@COLOR easyknack.node.VALUE.title.light=${easyknack.node.MATH.title.light}
@COLOR easyknack.node.VALUE.title.dark=${easyknack.node.MATH.title.dark}
@COLOR easyknack.node.WAVETABLE.title.light=#E5AF55
@COLOR easyknack.node.WAVETABLE.title.dark=#8C6332

@COLOR easyknack.diagnostics.mean=#66C9A5
@COLOR easyknack.diagnostics.peak=#E6BC6A
@COLOR easyknack.diagnostics.error=#EF7272

@COLOR easyknack.analysis.triggerLow=#F0AA41

@COLOR easyknack.analysis.triggerHigh=#50C3F0

@COLOR easyknack.signal.HISTORY=#B595D6
@COLOR easyknack.signal.ANALYSIS=#E7C84B
@COLOR easyknack.signal.SPECTRUM=${easyknack.signal.ANALYSIS}
@COLOR easyknack.node.ANALYSIS.title.light=${easyknack.signal.ANALYSIS}
@COLOR easyknack.node.ANALYSIS.title.dark=#8E782B

@COLOR easyknack.signal.TRIGGER=#E5A86D

@COLOR easyknack.buffer.selection=#26445A
@COLOR easyknack.buffer.boundary=#50C3F0

@COLOR easyknack.signal.VECTOR=#66B8DB
@COLOR easyknack.node.VECTOR.title.light=#66B8DB
@COLOR easyknack.node.VECTOR.title.dark=#365A78
